<Window x:Class="MrCheater.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MrCheater.UI.ViewModels"
        xmlns:views="clr-namespace:MrCheater.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Universal Game Cheat &amp; Macro Manager"
        Height="780" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Status Header -->
            <RowDefinition Height="*" />    <!-- Main Content Area with Sidebar -->
            <RowDefinition Height="Auto" /> <!-- Execution Progress Bar -->
        </Grid.RowDefinitions>

        <!-- Top Global Status Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mr.Cheater" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="PS2 / UNIVERSAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="8,2,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Status Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- Active Game Pill -->
                    <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Game:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding ActiveProfile.Name, FallbackValue='None'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Master Code Status Pill (Click to Toggle / Reset) -->
                    <Button Command="{Binding ToggleMasterCodeStateCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0">
                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMasterCodeActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding MasterCodeStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Target Process Status Pill -->
                    <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding TargetProcessStatus, Converter={StaticResource TargetStatusToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProfile.EmulatorName, FallbackValue='Target'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding TargetProcessText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Controller Status Pill -->
                    <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding IsControllerConnected, Converter={StaticResource ControllerStatusToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Controller:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ControllerStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Emergency Stop Hotkey Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="EMERGENCY STOP [Ctrl+Shift+Esc]"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="12,6" FontSize="11"
                            Command="{Binding TriggerEmergencyStopCommand}" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    
                    <Button Content="Dashboard" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Dashboard}" />

                    <Button Content="Cheats Library" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Cheats}" />

                    <Button Content="Sequence Editor" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.SequenceEditor}" />

                    <Button Content="Macro Engine" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Macros}" />

                    <Button Content="Controllers &amp; Keys" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Controllers}" />

                    <Button Content="Game Profiles" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Profiles}" />

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,12" />

                    <Button Content="Settings" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationPage.Settings}" />

                </StackPanel>
            </Border>

            <!-- Page Views Content Area using ContentControl with DataTemplates -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CheatsViewModel}">
                            <views:CheatsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SequenceEditorViewModel}">
                            <views:SequenceEditorView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:MacrosViewModel}">
                            <views:MacrosView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ControllersViewModel}">
                            <views:ControllersView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                            <views:ProfilesView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Toast Overlay Alert -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,16,20,0"
                        Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Execution Status Overlay Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,8"
                Visibility="{Binding IsExecutingSequence, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EXECUTING:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ExecutingSequenceTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ExecutionStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <ProgressBar Grid.Column="1" Height="6" Value="{Binding ExecutionProgressPercentage}" Maximum="100" Margin="20,0" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BgDarkBrush}" />

                <Button Grid.Column="2" Content="Stop" Style="{StaticResource DangerButtonStyle}" Padding="10,4" FontSize="11" Command="{Binding TriggerEmergencyStopCommand}" />
            </Grid>
        </Border>

    </Grid>
</Window>
