<UserControl x:Class="MrCheater.UI.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:MrCheater.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MacrosViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Macro &amp; Combo Engine" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Automate repeated button sequences, frame-perfect fighting combos, and loops" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="+ Add New Macro" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddNewMacroCommand}" />
        </Grid>

        <!-- Macros List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LoopCount, StringFormat='Loops: {0}x'}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource AccentActiveBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding AssignedHotkey, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AssignedHotkey, StringFormat='Hotkey: {0}'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />

                                    <!-- Sequence Preview -->
                                    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="5" Padding="8,5" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Sequence, Converter={StaticResource SequenceToPreviewConverter}}" FontFamily="Consolas, monospace" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Run Macro ⚡" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.ExecuteMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.DeleteMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
