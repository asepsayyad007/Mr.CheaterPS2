<UserControl x:Class="MrCheater.UI.Views.CheatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:MrCheater.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CheatsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Cheat Code Library" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Browse, search, edit, and trigger cheat sequences" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="+ Add New Cheat" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddNewCheatCommand}" />
        </Grid>

        <!-- Filter & Search Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search input -->
            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" FontSize="13" />

            <!-- Category Chips -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,0,0">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                                    Click="OnCategoryChipClicked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Cheat Cards List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredCheats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Cheat Info & Sequence Visualizer -->
                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button Content="★" FontSize="15" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{Binding IsFavorite, Converter={StaticResource ControllerStatusToBrushConverter}}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                        <!-- Prerequisite Badge -->
                                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding RequiresMasterCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Requires Master Code" FontSize="11" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Category Badge -->
                                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>

                                        <!-- Hotkey Badge -->
                                        <Border Background="{StaticResource AccentActiveBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding AssignedHotkey, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AssignedHotkey, StringFormat='Hotkey: {0}'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />

                                    <!-- Sequence Preview -->
                                    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="5" Padding="8,5" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Sequence, Converter={StaticResource SequenceToPreviewConverter}}" FontFamily="Consolas, monospace" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Execute" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="14,8"
                                            Command="{Binding DataContext.ExecuteCheatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCheatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Duplicate" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.DuplicateCheatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.DeleteCheatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
