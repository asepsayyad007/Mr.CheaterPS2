<UserControl x:Class="MrCheater.UI.Views.ControllersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:MrCheater.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ControllersViewModel}"
             d:DesignHeight="750" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Controllers &amp; Input Mapping" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="XInput gamepad detection and custom keyboard/controller keybindings" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reset to Default PS2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ResetToDefaultPs2Command}" />
                    <Button Content="Save Mappings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveMappingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Controller Live State Visualizer Card -->
            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding IsConnected, Converter={StaticResource ControllerStatusToBrushConverter}}" />
                            <TextBlock Text="{Binding ControllerName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding ActiveButtonsDisplay, StringFormat='Pressed: {0}'}" FontSize="12" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Visual Controller Layout Badges -->
                    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Controls: D-Pad & Left Shoulder -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="D-PAD &amp; SHOULDERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />

                                <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Center"
                                        Opacity="{Binding BtnLb, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="LB (L1)" FontWeight="Bold" FontSize="11" />
                                </Border>

                                <Grid Width="120" Height="100">
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Center"
                                            BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="↑" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="↓" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="←" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Center: Start, Back & Guide -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="BACK / SELECT" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="START" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="🎮 XInput Active" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Right Controls: Face Buttons & Right Shoulder -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="ACTION BUTTONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />

                                <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="RB (R1)" FontWeight="Bold" FontSize="11" />
                                </Border>

                                <Grid Width="120" Height="100">
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Center"
                                            BorderBrush="#00FFCC" BorderThickness="1">
                                        <TextBlock Text="Y (△)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#00FFCC" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            BorderBrush="#88CCFF" BorderThickness="1">
                                        <TextBlock Text="A (✕)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#88CCFF" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            BorderBrush="#FF99FF" BorderThickness="1">
                                        <TextBlock Text="X (▢)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF99FF" />
                                    </Border>
                                    <Border Width="34" Height="28" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            BorderBrush="#FF6688" BorderThickness="1">
                                        <TextBlock Text="B (◯)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF6688" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Key Mapping Table -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding MappingEntries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="{StaticResource SurfaceCardBrush}"
                          AlternatingRowBackground="{StaticResource SurfaceHoverBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderDarkBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action Identifier" Binding="{Binding ActionName}" Width="150" IsReadOnly="True" FontWeight="Bold" />
                        <DataGridTextColumn Header="Display Label" Binding="{Binding DisplayLabel}" Width="200" />
                        <DataGridTextColumn Header="Keyboard Key (SendInput)" Binding="{Binding KeyboardKey}" Width="200" />
                        <DataGridTextColumn Header="XInput Controller Button" Binding="{Binding XInputButton}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
