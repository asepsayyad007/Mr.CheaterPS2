<UserControl x:Class="MrCheater.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:MrCheater.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Welcome & Quick Switcher -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Universal Cheat Manager" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Automated sequence execution &amp; controller macros for emulators and games" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Profile Picker Combo with clean 2-way binding -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Active Game:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding SelectedProfileCombo, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="220" />
                </StackPanel>
            </Grid>

            <!-- Status Cards Row -->
            <UniformGrid Columns="3" Margin="0,0,0,24">
                
                <!-- Card 1: Selected Game Profile -->
                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SELECTED GAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.Name, FallbackValue='None Selected'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveProfile.GameCode, StringFormat='Game ID: {0}', FallbackValue='ID: Custom'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ActiveProfile.EmulatorName, StringFormat='Target: {0}'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 2: Cheat Collection Summary -->
                <Border Style="{StaticResource ModernCardStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="AVAILABLE CHEATS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.Cheats.Count, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Configured input sequences" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Content="Open Cheat Library" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenCheatLibraryCommand}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Macro & Quick Action -->
                <Border Style="{StaticResource ModernCardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MACROS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.Macros.Count, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Multi-step combos &amp; loops" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Content="+ Create New Cheat" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding CreateNewCheatCommand}" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Quick Cheats Section -->
            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Quick Cheat Launcher" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="View All" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,4" FontSize="11" Command="{Binding OpenCheatLibraryCommand}" />
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding QuickCheats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceHoverBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,12" Width="260">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,10" MaxHeight="36" TextTrimming="CharacterEllipsis" />

                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="{Binding AssignedHotkey, StringFormat='[{0}]'}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AssignedHotkey, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <Button Content="Execute" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="12,5" FontSize="12"
                                                    Command="{Binding DataContext.ExecuteQuickCheatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Activity Log -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Text="Activity &amp; Execution Log" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ListBox ItemsSource="{Binding RecentLogs}" MaxHeight="180" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas, monospace" FontSize="11" Margin="2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
