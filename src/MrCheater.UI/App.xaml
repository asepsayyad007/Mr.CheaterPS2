<Application x:Class="MrCheater.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MrCheater.UI.Converters"
             Startup="OnAppStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DarkTheme.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:TargetStatusToBrushConverter x:Key="TargetStatusToBrushConverter" />
            <conv:ControllerStatusToBrushConverter x:Key="ControllerStatusToBrushConverter" />
            <conv:SequenceToPreviewConverter x:Key="SequenceToPreviewConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
